{
  "name": "novelist-app",
  "private": true,
  "version": "0.1.0",
  "description": "Novelist Studio - Web App viết tiểu thuyết chuyên nghiệp chạy 100% trên Cloudflare Free Tier",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "deploy": "pnpm run build && pnpm run deploy:api && pnpm run deploy:web",
    "deploy:api": "pnpm --filter api deploy",
    "deploy:web": "pnpm --filter web deploy"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
